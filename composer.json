{
    "name": "hermesihq/hermesi",
    "description": "Server-side client for Hermesi: publish events and read what became of them, keep subscribers in sync, send a direct message, mint subscriber tokens and preference links. Works with any PSR-18 HTTP client.",
    "type": "library",
    "license": "MIT",
    "keywords": ["hermesi", "notifications", "sdk", "psr-18", "push", "email"],
    "homepage": "https://github.com/hermesihq/php",
    "support": {
        "issues": "https://github.com/hermesihq/php/issues",
        "source": "https://github.com/hermesihq/php"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "1.0",
        "psr/http-factory": "^1.0",
        "psr/http-factory-implementation": "1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/guzzle": "^7.9",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5",
        "symfony/http-client": "^6.4 || ^7.0",
        "symfony/var-dumper": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "Hermesi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hermesi\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff"
    },
    "minimum-stability": "stable"
}
